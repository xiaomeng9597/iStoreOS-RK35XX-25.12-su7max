config NET_DSA_YT921X
	tristate "Motorcomm YT9215 ethernet switch chip support"
	# BSP 6.1: default y so release configs lacking this symbol (resolved
	# non-interactively by syncconfig, e.g. ophub CI config-6.1) still
	# build the driver; with NET_DSA=m this caps to m like other drivers.
	default y
	select NET_DSA_TAG_YT921X
	help
	  This enables support for the Motorcomm YT9215 ethernet switch
	  chip.
